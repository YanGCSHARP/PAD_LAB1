# Скопируйте в .env (в lab1/ или в корень репозитория) и вставьте свои ключи.
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...

# Langfuse (необязательно) — трейсы каждого запроса: https://cloud.langfuse.com
# Settings → API Keys. Без этих строк трассировка просто выключена.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
